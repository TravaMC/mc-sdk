{
  "name": "mc-sdk",
  "version": "3.2.0",
  "description": "MCP server for Paper, Folia, Purpur, and Velocity plugin development — versioned Javadocs, docs, NMS mappings, Hangar, templates",
  "license": "MIT",
  "author": "mc-sdk contributors",
  "type": "module",
  "bin": {
    "mc-sdk": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "mcp.json.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/unit.test.ts test/v32.test.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "minecraft",
    "paper",
    "folia",
    "purpur",
    "velocity",
    "javadoc",
    "nms",
    "paperweight",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TravaMC/mc-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TravaMC/mc-sdk/issues"
  },
  "homepage": "https://github.com/TravaMC/mc-sdk#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
